# =============================================================================
# state.env.example
#
# Template for deploy/state.env — the file written by the deploy scripts to
# record resolved AWS resource IDs and endpoints after provisioning.
#
# Copy this file to deploy/state.env and fill in the real values, OR simply
# run `bash deploy/run_all.sh` which generates it automatically.
#
# This file is gitignored — never commit the real state.env.
# =============================================================================

# AMI ID for environment (Odoo) workspaces.
# Written by deploy/09_dev_env.sh after baking the golden AMI.
# If unset, the Coder template auto-resolves the latest Ubuntu 22.04 AMI
# for the current region via a data source (no hardcoded AMI needed).
ENV_AMI_ID=ami-XXXXXXXXXXXXXXXXX

# IAM instance profile attached to the ephemeral builder workspace.
# Created by deploy/10_builder.sh.
BUILD_INSTANCE_PROFILE=odoo-XXXXXXXXXXXXXXXXXXX

# Security group for the Coder server EC2 instance.
# Created by deploy/11_coder_server.sh.
CODER_SG_ID=sg-0XXXXXXXXXXXXXXX

# IAM instance profile for the Coder server itself.
CODER_INSTANCE_PROFILE=odoo-XXXXXXXXXXXXXXX

# Public IP of the Coder server EC2 instance (assigned on boot).
CODER_SERVER_IP=XX.XXX.XX.XX

# EC2 instance ID of the running Coder server.
CODER_INSTANCE_ID=i-0XXXXXXXXXXXXXXX

# Full URL to the Coder server dashboard (http://<ip>:8943).
CODER_URL=http://XX.XXX.XX.XX:XXXX

# AWS account ID where resources are provisioned.
# Used for ECR URLs, Secrets Manager ARNs, and IAM references.
AWS_ACCOUNT_ID=XXXXXXXXXXXX

# Security group for environment (Odoo) workspaces.
ENV_SG_ID=sg-0XXXXXXXXXXXXXXX

# Subnet ID where environment workspaces are launched.
ENV_SUBNET_ID=subnet-0XXXXXXXXXXXXXXX

# IAM instance profile for environment (Odoo) workspaces.
ENV_INSTANCE_PROFILE=odoo-XXXXXXXXXXXXXXX

# Git repository URL for the Odoo custom addons repo.
# Replace with your organisation's repo (community users: use your own fork).
ENV_REPO_URL=https://github.com/<your-org>/<your-repo>

# Git branch or commit SHA to check out for the env workspace.
ENV_REPO_BRANCH=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secrets Manager ARN storing the git access token for the env repo.
# Created by deploy/11_coder_server.sh.
ENV_GIT_TOKEN_SECRET=arn:aws:secretsmanager:<region>:<account-id>:secret:<secret-name>