# ----------------------------------------------------------------------
# presets.tf.example
#
# Reference template showing the structure of auto-generated presets.
# The real presets.tf is generated by deploy/_gen_presets.py from your
# profile + run stores and is gitignored (it contains your own repo URLs,
# ECR image URIs, S3 dump paths, and Secrets Manager ARNs).
#
# To generate your own presets:
#   1. Build a profile:  odoo-synth profile build <profile-id>
#   2. Run masking:      odoo-synth run mask <profile-id>
#   3. Publish:          bash deploy/12_publish_template.sh
#
# Each preset becomes a one-click "Create workspace" option in the Coder
# dashboard, carrying the image, dump, git token secret, repo, and
# discovery-derived odoo.conf extras.
# ----------------------------------------------------------------------

# Preset for profile <profile-id> (auto-generated by deploy/_gen_presets.py)
data "coder_workspace_preset" "profile_<profile_id>" {
  default     = true  # first preset becomes the default
  name        = "<profile label>"
  description = "<profile description>"
  parameters = {
    odoo_image          = "<account-id>.dkr.ecr.<region>.amazonaws.com/odoo-synth/odoo:<profile-id>-<build-hash>"
    dump_s3_uri         = "s3://<bucket>/masked-dumps/<run-id>/masked.dump"
    git_token_secret    = "arn:aws:secretsmanager:<region>:<account-id>:secret:odoo-synth/profile/<profile-id>/git-token-<random>"
    instance_type       = "t3.large"
    odoo_conf_extra_b64 = "<base64-encoded odoo.conf extras>"
    repo_url            = "git@github.com:<your-org>/<your-repo>.git"
    repo_branch         = "<branch-or-sha>"
  }
}