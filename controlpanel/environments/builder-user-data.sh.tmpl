#!/usr/bin/env bash
# Ephemeral odoo-image builder (decision 1b: a dedicated throwaway instance, not
# the panel host). Downloads the odoo/ build context, bakes the profile's
# provenance + discovered python deps into an immutable image, pushes it to ECR,
# reports the result to S3, then terminates itself.
set -uo pipefail

REGION="__AWS_REGION__"
CONTEXT_GET_URL="__CONTEXT_GET_URL__"
RESULT_PUT_URL="__RESULT_PUT_URL__"
IMAGE_URI="__IMAGE_URI__"
ODOO_IMAGE_BASE="__ODOO_IMAGE_BASE__"
ODOO_GIT_URL="__ODOO_GIT_URL__"
ODOO_GIT_REF="__ODOO_GIT_REF__"
CUSTOM_ADDONS_GIT_URL="__CUSTOM_ADDONS_GIT_URL__"
CUSTOM_ADDONS_GIT_REF="__CUSTOM_ADDONS_GIT_REF__"
PYTHON_DEPS="__PYTHON_DEPS__"
GIT_TOKEN_SECRET="__GIT_TOKEN_SECRET__"

LOG=/var/log/odoo-synth-build.log
exec > >(tee -a "$LOG") 2>&1
echo "[build] $(date -u) starting build for ${IMAGE_URI}"

STATUS="failed"
ERROR=""

finish() {
  # best-effort: upload a small JSON result, then self-terminate.
  TAIL="$(tail -c 12000 "$LOG" 2>/dev/null | python3 -c 'import sys,json;print(json.dumps(sys.stdin.read()))' 2>/dev/null || echo \"\")"
  printf '{"status":"%s","image_uri":"%s","error":%s,"log_tail":%s}\n' \
    "$STATUS" "$IMAGE_URI" \
    "$(printf '%s' "$ERROR" | python3 -c 'import sys,json;print(json.dumps(sys.stdin.read()))' 2>/dev/null || echo '""')" \
    "$TAIL" > /tmp/build-result.json
  curl -sS -X PUT -H "Content-Type: application/json" \
    --data-binary @/tmp/build-result.json "$RESULT_PUT_URL" || true
  echo "[build] result uploaded (status=$STATUS); terminating instance"
  TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300" 2>/dev/null || true)
  IID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
    http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null || true)
  if [ -n "$IID" ]; then
    aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || true
  fi
}
trap finish EXIT

fail() { ERROR="$1"; echo "[build] ERROR: $1"; exit 1; }

# --- prerequisites (docker, awscli, curl) -----------------------------------
if ! command -v docker >/dev/null 2>&1; then
  echo "[build] installing docker ..."
  if command -v dnf >/dev/null 2>&1; then dnf install -y docker || fail "docker install failed"; \
  elif command -v yum >/dev/null 2>&1; then yum install -y docker || fail "docker install failed"; \
  elif command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y docker.io || fail "docker install failed"; fi
fi
systemctl enable --now docker 2>/dev/null || service docker start 2>/dev/null || true
command -v aws >/dev/null 2>&1 || { command -v dnf >/dev/null 2>&1 && dnf install -y awscli || yum install -y awscli || apt-get install -y awscli; }

export DOCKER_BUILDKIT=1

# --- fetch the build context -------------------------------------------------
mkdir -p /root/ctx
echo "[build] downloading build context ..."
curl -fsSL "$CONTEXT_GET_URL" -o /root/ctx.tgz || fail "could not download build context"
tar xzf /root/ctx.tgz -C /root/ctx || fail "could not extract build context"
# ensure bake-in dirs exist so COPY steps never fail
mkdir -p /root/ctx/enterprise /root/ctx/custom-addons
touch /root/ctx/enterprise/.gitkeep /root/ctx/custom-addons/.gitkeep

# --- resolve git token for private addons clone -----------------------------
GH_TOKEN_FILE="$(mktemp)"; chmod 600 "$GH_TOKEN_FILE"
if [ -n "$GIT_TOKEN_SECRET" ]; then
  aws secretsmanager get-secret-value --region "$REGION" --secret-id "$GIT_TOKEN_SECRET" \
    --query SecretString --output text > "$GH_TOKEN_FILE" 2>/dev/null || true
fi
[ -s "$GH_TOKEN_FILE" ] && echo "[build] git token resolved for custom-addons clone" \
  || echo "[build] no git token (public addons or none)"

# --- ECR login ---------------------------------------------------------------
REGISTRY="$(echo "$IMAGE_URI" | cut -d/ -f1)"
echo "[build] logging in to ECR $REGISTRY ..."
aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$REGISTRY" || fail "ECR login failed"

# --- build -------------------------------------------------------------------
echo "[build] building image ${IMAGE_URI} (python_deps: ${PYTHON_DEPS:-none}) ..."
docker build --platform linux/amd64 \
  --build-arg ODOO_IMAGE="$ODOO_IMAGE_BASE" \
  --build-arg ODOO_GIT_URL="$ODOO_GIT_URL" \
  --build-arg ODOO_GIT_REF="$ODOO_GIT_REF" \
  --build-arg CUSTOM_ADDONS_GIT_URL="$CUSTOM_ADDONS_GIT_URL" \
  --build-arg CUSTOM_ADDONS_GIT_REF="$CUSTOM_ADDONS_GIT_REF" \
  --build-arg PYTHON_DEPS="$PYTHON_DEPS" \
  --secret id=gh_token,src="$GH_TOKEN_FILE" \
  -t "$IMAGE_URI" /root/ctx || fail "docker build failed"

echo "[build] pushing ${IMAGE_URI} ..."
docker push "$IMAGE_URI" || fail "docker push failed"

STATUS="succeeded"
echo "[build] done: ${IMAGE_URI}"
