#!/usr/bin/env bash
# Per-environment boot script (EC2 user-data), rendered by the control panel.
# Thin AMI (ubuntu + docker + code-server); runs the provenance-baked odoo image
# against a local postgres seeded from the masked dump, with the addons repo
# bind-mounted live. Placeholders are substituted server-side before launch.
set -euo pipefail
exec > >(tee -a /var/log/odoo-synth-env.log) 2>&1
echo "[env __ENV_ID__] boot $(date -u +%FT%TZ) issue=__ISSUE__"

REGION="__AWS_REGION__"
DUMP_S3_URI="__DUMP_S3_URI__"
SECRET_ARN="__SECRET_ARN__"
ODOO_IMAGE="__ODOO_IMAGE__"
REPO_URL="__REPO_URL__"
REPO_BRANCH="__REPO_BRANCH__"
GIT_TOKEN_SECRET="__GIT_TOKEN_SECRET__"
DB_NAME="__DB_NAME__"
CODE_PORT="__CODE_PORT__"
ODOO_PORT="__ODOO_PORT__"
ODOO_MASTER_PASSWORD="__ODOO_MASTER_PASSWORD__"
ODOO_CONF_EXTRA_B64="__ODOO_CONF_EXTRA_B64__"
WORKSPACE="/home/dev/workspace"
REPO_DIR="$WORKSPACE/repo"
PGPASS="odoo"
NET="envnet"

mkdir -p "$WORKSPACE"
# workspace must be owned by the dev user before we clone into it as that user
# (the clone + code-server run as dev).
chown -R dev:dev /home/dev
docker network create "$NET" >/dev/null 2>&1 || true

# --- 1. local postgres holding the masked data -----------------------------
docker rm -f env-db >/dev/null 2>&1 || true
docker run -d --name env-db --network "$NET" \
  -e POSTGRES_PASSWORD="$PGPASS" \
  -e POSTGRES_USER=odoo \
  -e POSTGRES_DB="$DB_NAME" \
  -p 127.0.0.1:5432:5432 \
  -v /var/lib/env-db:/var/lib/postgresql/data \
  postgres:16

echo "[env __ENV_ID__] waiting for postgres ..."
for _ in $(seq 1 60); do
  if docker exec env-db pg_isready -U odoo -d "$DB_NAME" >/dev/null 2>&1; then break; fi
  sleep 2
done

# --- 2. seed from the masked dump ------------------------------------------
if [ -n "$DUMP_S3_URI" ]; then
  echo "[env __ENV_ID__] downloading masked dump $DUMP_S3_URI"
  aws s3 cp "$DUMP_S3_URI" /tmp/masked.dump --region "$REGION"
  echo "[env __ENV_ID__] restoring masked dump into $DB_NAME"
  # --disable-triggers defers FK enforcement (SET session_replication_role =
  # replica) during the data COPY. Without it, rows whose audit columns
  # (create_uid/write_uid) reference a user deleted in the source are silently
  # dropped by pg_restore -- which can take out core records like
  # base.public_user and 500 every request. Generic across sources. (odoo is
  # superuser in this container.)
  docker exec -i env-db pg_restore -U odoo -d "$DB_NAME" \
      --no-owner --no-privileges --clean --if-exists --disable-triggers \
      < /tmp/masked.dump || true
  rm -f /tmp/masked.dump
  echo "[env __ENV_ID__] restore complete"
fi

# --- 3. optional GitHub token (private addons repo clone) ------------------
GIT_TOKEN=""
if [ -n "$GIT_TOKEN_SECRET" ]; then
  GIT_TOKEN="$(aws secretsmanager get-secret-value --secret-id "$GIT_TOKEN_SECRET" \
      --region "$REGION" --query SecretString --output text 2>/dev/null || echo '')"
fi

# --- 4. clone the addons repo into the workspace ---------------------------
if [ -n "$REPO_URL" ]; then
  CLONE_URL="$REPO_URL"
  if [ -n "$GIT_TOKEN" ]; then
    CLONE_URL="$(printf '%s' "$REPO_URL" | sed -E "s#https://#https://x-access-token:${GIT_TOKEN}@#")"
  fi
  # REPO_BRANCH may be a branch, tag, OR a bare commit SHA. `git clone --branch`
  # only accepts branch/tag names, so: clone default, then check out the ref --
  # fetching it explicitly if it isn't already present (bare SHA case).
  if sudo -u dev git clone "$CLONE_URL" "$REPO_DIR"; then
    if [ -n "$REPO_BRANCH" ]; then
      sudo -u dev git -C "$REPO_DIR" checkout "$REPO_BRANCH" 2>/dev/null \
        || { sudo -u dev git -C "$REPO_DIR" fetch --depth 1 origin "$REPO_BRANCH" \
             && sudo -u dev git -C "$REPO_DIR" checkout FETCH_HEAD; } \
        || echo "[env __ENV_ID__] could not check out ref $REPO_BRANCH"
    fi
  else
    echo "[env __ENV_ID__] repo clone skipped/failed"
  fi
  if [ -n "$GIT_TOKEN" ] && [ -d "$REPO_DIR/.git" ]; then
    sudo -u dev git -C "$REPO_DIR" remote set-url origin "$REPO_URL" || true
  fi
fi
chown -R dev:dev /home/dev

# --- 5. pull + run the provenance-baked odoo image against the masked DB ----
if [ -n "$ODOO_IMAGE" ]; then
  echo "[env __ENV_ID__] ECR login + pulling odoo image $ODOO_IMAGE"
  REG="${ODOO_IMAGE%%/*}"
  aws ecr get-login-password --region "$REGION" \
    | docker login --username AWS --password-stdin "$REG" || true
  docker pull "$ODOO_IMAGE" || echo "[env __ENV_ID__] odoo image pull failed"

  MOUNT_ARGS=""
  if [ -d "$REPO_DIR" ]; then
    # Every dir holding a module (__manifest__.py child) becomes an addons dir,
    # mapped to its path under /mnt/live and passed to addons_path (comma-sep).
    ADDON_DIRS="$(cd "$REPO_DIR" && find . -maxdepth 3 -name __manifest__.py -printf '%h\n' 2>/dev/null \
      | sed 's#/[^/]*$##' | sed 's#^\./\{0,1\}##' | sort -u)"
    EXTRA=""
    if [ -n "$ADDON_DIRS" ]; then
      while IFS= read -r rel; do
        [ -z "$rel" ] && cpath="/mnt/live" || cpath="/mnt/live/$rel"
        EXTRA="${EXTRA:+$EXTRA,}$cpath"
      done <<< "$ADDON_DIRS"
    else
      EXTRA="/mnt/live"
    fi
    echo "[env __ENV_ID__] addons dirs detected: $EXTRA"
    MOUNT_ARGS="-v ${REPO_DIR}:/mnt/live:rw -e EXTRA_ADDONS_PATH=${EXTRA}"
  fi

  # Odoo is HTTP-only on the docker net + loopback (health probe). The env-tls
  # nginx sidecar terminates TLS on ${ODOO_PORT}; proxy_mode=True trusts XFF.
  docker rm -f env-odoo >/dev/null 2>&1 || true
  docker run -d --name env-odoo --network "$NET" \
    -p 127.0.0.1:18069:8069 \
    -e TARGET_DB_HOST=env-db \
    -e TARGET_DB_PORT=5432 \
    -e TARGET_DB_NAME="$DB_NAME" \
    -e TARGET_DB_USER=odoo \
    -e TARGET_DB_PASSWORD="$PGPASS" \
    -e ODOO_MASTER_PASSWORD="$ODOO_MASTER_PASSWORD" \
    -e ODOO_CONF_EXTRA_B64="$ODOO_CONF_EXTRA_B64" \
    $MOUNT_ARGS \
    "$ODOO_IMAGE" || echo "[env __ENV_ID__] odoo container failed to start"
  echo "[env __ENV_ID__] odoo (http, internal) up; fronting with TLS on :${ODOO_PORT}"

  # --- 5a-tls. HTTPS termination in front of Odoo (nginx sidecar) -----------
  install -d -m 700 /etc/odoo-tls
  if [ ! -f /etc/odoo-tls/cert.pem ]; then
    openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
      -keyout /etc/odoo-tls/key.pem -out /etc/odoo-tls/cert.pem \
      -subj "/CN=odoo-synth-env-__ENV_ID__" >/dev/null 2>&1 \
      || echo "[env __ENV_ID__] WARN: self-signed cert generation failed"
  fi
  cat > /etc/odoo-tls/nginx.conf <<'NGINX'
worker_processes 1;
events { worker_connections 1024; }
http {
  sendfile on;
  keepalive_timeout 65;
  client_max_body_size 500m;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 443 ssl;
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    proxy_read_timeout 720s;
    proxy_connect_timeout 5s;
    location /websocket {
      proxy_pass http://env-odoo:8069;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Real-IP $remote_addr;
    }
    location / {
      proxy_pass http://env-odoo:8069;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_redirect off;
    }
  }
}
NGINX
  docker rm -f env-tls >/dev/null 2>&1 || true
  docker run -d --name env-tls --network "$NET" --restart unless-stopped \
    -p 0.0.0.0:${ODOO_PORT}:443 \
    -v /etc/odoo-tls/cert.pem:/etc/nginx/tls/cert.pem:ro \
    -v /etc/odoo-tls/key.pem:/etc/nginx/tls/key.pem:ro \
    -v /etc/odoo-tls/nginx.conf:/etc/nginx/nginx.conf:ro \
    nginx:alpine >/dev/null 2>&1 \
    && echo "[env __ENV_ID__] TLS proxy up: https on :${ODOO_PORT} -> env-odoo:8069" \
    || echo "[env __ENV_ID__] WARN: TLS proxy failed to start"

  # --- 5a. install the addons' Python deps into the odoo container -----------
  # The baked odoo image carries only the deps discovered for ITS provenance.
  # A different addons repo may declare extra external_dependencies (python) in
  # its module manifests; without them Odoo crashes building the registry
  # (ModuleNotFoundError). Collect them from the mounted manifests + any
  # requirements.txt in the repo, pip install into the container, then restart.
  if [ -d "$REPO_DIR" ]; then
    DEPS="$(docker exec env-odoo python3 - <<'PY' 2>/dev/null || true
import ast, glob
# import-name -> pip-name for the common Odoo mismatches; others pass through.
MAP = {"dateutil": "python-dateutil", "ldap": "python-ldap", "Crypto": "pycryptodome",
       "jwt": "pyjwt", "OpenSSL": "pyOpenSSL", "PIL": "Pillow", "yaml": "PyYAML",
       "bs4": "beautifulsoup4", "magic": "python-magic", "wand": "Wand"}
pkgs = set()
for m in glob.glob('/mnt/live/**/__manifest__.py', recursive=True):
    try:
        d = ast.literal_eval(open(m).read())
    except Exception:
        continue
    for p in ((d.get('external_dependencies') or {}).get('python') or []):
        pkgs.add(MAP.get(p, p))
print(' '.join(sorted(pkgs)))
PY
)"
    REQS="$(find "$REPO_DIR" -maxdepth 3 -name requirements.txt 2>/dev/null | head -5)"
    if [ -n "$DEPS" ] || [ -n "$REQS" ]; then
      echo "[env __ENV_ID__] installing addon python deps: ${DEPS:-<none>} $( [ -n "$REQS" ] && echo '+ requirements.txt' )"
      REQ_ARGS=""
      for r in $REQS; do REQ_ARGS="$REQ_ARGS -r /mnt/live/${r#$REPO_DIR/}"; done
      # shellcheck disable=SC2086
      docker exec env-odoo pip install --no-cache-dir $DEPS $REQ_ARGS \
        >/home/dev/workspace/pip-addons.log 2>&1 \
        && echo "[env __ENV_ID__] addon deps installed" \
        || echo "[env __ENV_ID__] some addon deps failed (see ~/workspace/pip-addons.log)"
      chown dev:dev /home/dev/workspace/pip-addons.log 2>/dev/null || true
      docker restart env-odoo >/dev/null 2>&1 || true
      echo "[env __ENV_ID__] odoo restarted after dep install"
    fi
  fi

  # --- 5b. restore a usable admin login --------------------------------------
  # Masking drops every res_users password and randomizes logins, so the masked
  # DB has no account you can sign in with. Reset the standard admin (id=2) to
  # login 'admin' with the per-env password (same value as code-server), hashing
  # it with odoo's own passlib so the hash scheme matches.
  ADMIN_PASS="$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" \
      --region "$REGION" --query SecretString --output text 2>/dev/null || echo '')"
  if [ -n "$ADMIN_PASS" ]; then
    echo "[env __ENV_ID__] resetting admin login"
    for _ in $(seq 1 30); do
      docker exec env-db pg_isready -U odoo -d "$DB_NAME" >/dev/null 2>&1 && break
      sleep 2
    done
    ADMIN_HASH="$(docker exec env-odoo python3 -c \
      "from passlib.context import CryptContext; print(CryptContext(['pbkdf2_sha512']).hash('$ADMIN_PASS'))" \
      2>/dev/null || echo '')"
    if [ -n "$ADMIN_HASH" ]; then
      docker exec env-db psql -U odoo -d "$DB_NAME" -c \
        "UPDATE res_users SET login='admin', password='$ADMIN_HASH', active=true WHERE id=2;" \
        >/dev/null 2>&1 \
        && echo "[env __ENV_ID__] admin login ready (user: admin)" \
        || echo "[env __ENV_ID__] admin reset failed (sql)"
    else
      echo "[env __ENV_ID__] admin reset failed (hash)"
    fi
  fi
fi

# --- 5c. odoo health probe + log surfacing ---------------------------------
# Odoo may crash while building its registry (e.g. a module fails to import).
# Surface the container logs to the cloud-init console log AND to a file the
# developer can open in VS Code, so failures are diagnosable without SSH.
if [ -n "$ODOO_IMAGE" ]; then
  sleep 15
  ODOO_STATUS="$(docker inspect -f '{{.State.Status}}' env-odoo 2>/dev/null || echo missing)"
  HTTP="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:18069/web/login 2>/dev/null || echo 000)"
  echo "[env __ENV_ID__] odoo container=${ODOO_STATUS} http=${HTTP}"
  install -d -o dev -g dev /home/dev/workspace
  docker logs --tail 200 env-odoo > /home/dev/workspace/odoo.log 2>&1 || true
  chown dev:dev /home/dev/workspace/odoo.log 2>/dev/null || true
  if [ "$ODOO_STATUS" != "running" ] || [ "$HTTP" = "500" ] || [ "$HTTP" = "000" ]; then
    echo "[env __ENV_ID__] ===== odoo logs (tail) ====="
    docker logs --tail 60 env-odoo 2>&1 | sed 's/^/[odoo] /' || true
    echo "[env __ENV_ID__] ===== end odoo logs ====="
  fi
fi

# --- 6. code-server password (per-env, from Secrets Manager) ---------------
CODE_PASS="$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" \
    --region "$REGION" --query SecretString --output text 2>/dev/null || echo '')"

# --- 6b. Remote-SSH access: inject the operator's SSH public key ------------
# Lets desktop VS Code (Remote-SSH) open the workspace via the deep link
# vscode://vscode-remote/ssh-remote+${SSH_USER}@<ip>/home/${SSH_USER}/workspace.
# Best-effort: skip cleanly if no key was configured.
SSH_USER="__SSH_USER__"
SSH_PUBKEY="$(printf '%s' "__SSH_PUBLIC_KEY_B64__" | base64 -d 2>/dev/null || true)"
if [ -n "$SSH_PUBKEY" ]; then
  SSH_HOME="$(getent passwd "$SSH_USER" | cut -d: -f6)"
  if [ -n "$SSH_HOME" ]; then
    install -d -o "$SSH_USER" -g "$SSH_USER" -m 700 "$SSH_HOME/.ssh"
    if ! grep -qxF "$SSH_PUBKEY" "$SSH_HOME/.ssh/authorized_keys" 2>/dev/null; then
      echo "$SSH_PUBKEY" >> "$SSH_HOME/.ssh/authorized_keys"
    fi
    chown "$SSH_USER:$SSH_USER" "$SSH_HOME/.ssh/authorized_keys"
    chmod 600 "$SSH_HOME/.ssh/authorized_keys"
  fi
fi

# --- 7. self-signed TLS + code-server systemd service ----------------------
install -d -o dev -g dev /home/dev/.config/code-server
cat > /home/dev/.config/code-server/config.yaml <<EOF
bind-addr: 0.0.0.0:${CODE_PORT}
auth: password
password: ${CODE_PASS}
cert: true
EOF
chown dev:dev /home/dev/.config/code-server/config.yaml
chmod 600 /home/dev/.config/code-server/config.yaml

cat > /etc/systemd/system/code-server.service <<EOF
[Unit]
Description=code-server (odoo-synth env __ENV_ID__)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=dev
Environment=HOME=/home/dev
ExecStart=/usr/bin/code-server ${WORKSPACE}
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now code-server

cat > "$WORKSPACE/ENVIRONMENT.md" <<EOF
# odoo-synth dev environment __ENV_ID__

- Issue: __ISSUE__
- Masked Odoo: https://<this-host>:${ODOO_PORT}/ (self-signed TLS)
- Masked DB:  postgresql://odoo:${PGPASS}@127.0.0.1:5432/${DB_NAME}
- Odoo image: __ODOO_IMAGE__
- Addons repo: __REPO_URL__ (${REPO_BRANCH:-default branch}) -- cloned at ./repo,
  bind-mounted live into Odoo. Edit here, then reload:
      docker restart env-odoo
      docker exec env-odoo python3 /opt/odoo-src/odoo-bin -c /etc/odoo/odoo.conf -u <module> --stop-after-init

Everything is local + disposable; torn down when the issue is closed.
EOF
chown dev:dev "$WORKSPACE/ENVIRONMENT.md"

echo "[env __ENV_ID__] ready; code-server on :${CODE_PORT}, odoo on :${ODOO_PORT}"

# --- 7. readiness signal ---------------------------------------------------
# The instance only becomes truly usable once Odoo answers HTTP (DB restore +
# module registry load can take several minutes). We poll Odoo locally, then
# tag the instance so the control panel can flip the env to "running" only
# when it is actually serving (best-effort: never fail boot on this).
signal_ready() {
  set +e
  local tok iid deadline
  tok="$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 300" 2>/dev/null)"
  iid="$(curl -s -H "X-aws-ec2-metadata-token: $tok" \
    http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null)"
  # wait up to ~12 min for Odoo to answer on the internal HTTP port.
  deadline=$(( $(date +%s) + 720 ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      http://127.0.0.1:18069/web/health 2>/dev/null)"
    if [ "$code" = "200" ] || [ "$code" = "303" ] || [ "$code" = "302" ]; then
      echo "[env __ENV_ID__] odoo answered http $code; marking ready"
      if [ -n "$iid" ]; then
        aws ec2 create-tags --region "$REGION" --resources "$iid" \
          --tags Key=odoo-synth:ready,Value=true >/dev/null 2>&1 \
          || echo "[env __ENV_ID__] WARN: could not tag ready (missing ec2:CreateTags?)"
      fi
      return 0
    fi
    sleep 10
  done
  echo "[env __ENV_ID__] WARN: odoo did not answer within timeout; tagging ready anyway"
  [ -n "$iid" ] && aws ec2 create-tags --region "$REGION" --resources "$iid" \
    --tags Key=odoo-synth:ready,Value=timeout >/dev/null 2>&1 || true
}
signal_ready

