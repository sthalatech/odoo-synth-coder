#!/usr/bin/env python3
"""Thin launcher for the odoo-synth CLI.

The real implementation lives in the importable ``cli`` package
(``cli/__init__.py``) so it can also be exposed as a setuptools console
script (``odoo-synth = cli:main``) via ``pip install -e .``. This file keeps
the historical ``./cli/odoo-synth`` invocation path and the symlink target
used by ``deploy/00_install_prereqs.sh`` working unchanged.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Allow running directly from a checkout (no install) by putting the repo root
# on sys.path so `import cli` resolves. Under an editable install this is a
# no-op (cli is already importable).
_REPO_ROOT = Path(__file__).resolve().parents[1]
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
