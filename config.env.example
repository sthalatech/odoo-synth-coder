# ---- odoo-synth-ecs pipeline configuration (all inputs are here) ----
# Copy to `config.env` and fill in. `config.env` is gitignored — never commit
# real passwords, account ids, or private repo URLs.
#
# AWS
AWS_REGION=us-east-1
PROJECT=odoo-synth

# Versions (configurable for prod differences)
# NOTE: enterprise, community/core, and custom addons MUST share the same major.
PG_MAJOR=16
ODOO_SERIES=17.0
ODOO_IMAGE=odoo:17
GREENMASK_VERSION=v0.2.22

# ---- Odoo from SOURCE (target service runs odoo-bin from a git checkout) ----
# The base image supplies system + Python deps; core Odoo is replaced by a
# source clone at ODOO_GIT_REF (a branch, tag, or commit from the provenance step).
ODOO_GIT_URL=https://github.com/odoo/odoo
# Pin to the last commit on your series before your prod dump was taken so the
# running code's schema matches the restored DB without a `-u all` migration.
ODOO_GIT_REF=<odoo-core-commit-sha>

# Custom addons (empty = core modules only). Three ways to supply addons, all
# baked into the shared odoo image (used by BOTH source and target):
#   1. Enterprise: drop the zip at odoo/enterprise.zip (auto-unzipped at build)
#      OR unzip its module folders directly under odoo/enterprise/.
#   2. Custom modules: put each module folder under odoo/custom-addons/.
#   3. Custom from git: set CUSTOM_ADDONS_GIT_URL (cloned to /mnt/extra-addons-custom).
# For live edit-reload dev without rebuilds, mount a volume and point the
# container's EXTRA_ADDONS_PATH env at it (highest addons_path priority).
CUSTOM_ADDONS_GIT_URL=<https://github.com/your-org/your-addons>
# Branch/tag/commit of the custom repo to match prod.
CUSTOM_ADDONS_GIT_REF=<custom-addons-commit-sha>

# Databases (source + masked live on the SAME RDS instance)
SOURCE_DB_NAME=source
TARGET_DB_NAME=masked
TARGET_DB_USER=odoo
TARGET_DB_PASSWORD=<choose-a-strong-password>

# RDS
RDS_INSTANCE_ID=odoo-synth-masked
RDS_INSTANCE_CLASS=db.t3.medium
RDS_ALLOCATED_GB=20

# Odoo
ODOO_ADMIN_PASSWORD=<choose-a-strong-password>
ODOO_MASTER_PASSWORD=<choose-a-strong-password>

# ECS
ECS_CLUSTER=odoo-synth
TASK_CPU=1024
TASK_MEM=2048

# Control panel: S3 bucket used to stage uploaded dump files (.sql/.zip) before a
# restore task streams them in. Referenced by name so each deployment uses its own.
DUMP_S3_BUCKET=<your-dumps-bucket>

# ---- Independent SOURCE stack (persistent; NOT torn down with masked) ----
SOURCE_RDS_INSTANCE_ID=odoo-synth-source
SOURCE_ECS_CLUSTER=odoo-synth-source
SOURCE_DB_MASTER_USER=odoo
SOURCE_DB_MASTER_PASSWORD=<choose-a-strong-password>
